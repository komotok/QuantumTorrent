{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quantum-torrent",
  "version": "0.1.0",
  "identifier": "com.komotok.qtorrent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuantumTorrent",
        "width": 1180,
        "height": 720,
        "minWidth": 880,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "Torrent File",
        "description": "BitTorrent Torrent File",
        "role": "Editor"
      }
    ],
    "resources": [
      "resources/*"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    }
  }
}
